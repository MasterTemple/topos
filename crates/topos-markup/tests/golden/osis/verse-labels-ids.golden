#### tree ####
Chapter chapter @start osisID="Gen.1" sID="c"
Verse verse @start osisID="Gen.1.1" sID="a"
text "a"
Verse verse @end eID="a"
Chapter chapter @end eID="c"
Chapter chapter n="2"
Verse verse n="1"
text "b"
Verse verse @start sID="Exod.3.4"
text "c"

