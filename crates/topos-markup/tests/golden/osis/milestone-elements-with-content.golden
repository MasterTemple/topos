#### markup ####
osis
#### input ####
<q who="Jesus" sID="a">inner woj</q> <q sID="b">inner quote</q> <p sID="c">para text</p> <l sID="d">line text</l> <l eID="d">end text</l> <title sID="e">title text</title> <lg sID="f">group text</lg> <verse sID="g" n="3">verse text</verse>
#### tree ####
WordsOfJesus q @start who="Jesus" sID="a"
  text "inner woj"
text " "
Quote q @start sID="b"
  text "inner quote"
text " "
Paragraph p @start sID="c"
  text "para text"
text " "
Line l @start sID="d"
  text "line text"
text " "
Line l @end eID="d"
  text "end text"
text " "
Title title @start sID="e"
  text "title text"
text " "
LineGroup lg @start sID="f"
  text "group text"
text " "
Verse verse @start sID="g" n="3"
  text "verse text"

#### text ####
para text
line text end text
group text
verse text
#### text-all ####
“
para text
line text end text
## title text
group text
[g :3] verse text”
#### text-nobreaks ####
para text line text end text group text verse text
#### spans ####
entries: 0..50
WordsOfJesus 0..50 entry=0 path=/0 "para text\nline text end text\ngroup text\nverse text"

