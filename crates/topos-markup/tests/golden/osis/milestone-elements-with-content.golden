#### html ####
  <br class="topos-p">  <br class="topos-l"> <span class="topos-woj">title text</span> <span class="topos-woj">group text</span> <span class="topos-woj">verse text</span>
#### html-bare ####
  <br class="p">  <br class="l"> <span class="woj">title text</span> <span class="woj">group text</span> <span class="woj">verse text</span>
#### verses ####
0:3-3 marker=/14 start=/14 end=/15 "verse text"
chapter_verses: []

